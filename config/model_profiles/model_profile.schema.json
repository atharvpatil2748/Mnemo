{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemo.local/schemas/model-profile-v1.json",
  "title": "Mnemo Phase 8.5 Model Profile Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": "mnemo.model-profiles/1"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "mode", "trust_class", "certification"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "mode": {"enum": ["phase8_5", "v1_only", "disabled"]},
        "trust_class": {"enum": ["local_trusted", "local_sandboxed", "cloud"]},
        "certification": {"enum": ["non_certified_default", "candidate", "certified"]},
        "certification_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "models": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vision": {"$ref": "#/$defs/component"},
            "multilingual_embedding": {"$ref": "#/$defs/component"},
            "multilingual_reranker": {"$ref": "#/$defs/component"},
            "visual_embedding": {"$ref": "#/$defs/component"}
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "revision", "license", "preprocessing"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "dimensions": {"type": "integer", "minimum": 1},
        "metric": {"enum": ["cosine", "dot", "euclidean"]},
        "normalization": {"enum": ["none", "l2"]},
        "preprocessing": {"type": "string", "minLength": 1},
        "languages": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "scripts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "language_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/provider_language_claim"}
        },
        "modalities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "max_batch": {"type": "integer", "minimum": 1},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "max_input_bytes": {"type": "integer", "minimum": 1},
        "max_pixels": {"type": "integer", "minimum": 1}
      }
    },
    "provider_language_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "operations", "claim_source_digest"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "script": {"type": "string", "minLength": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "claim_source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
