{
  "request": {
    "$defs": {
      "AllAuthorizedNotebooks": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "all_authorized",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "AllAuthorizedNotebooks",
        "type": "object"
      },
      "DocumentSelection": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "notebook_id": {
            "format": "uuid",
            "title": "Notebook Id",
            "type": "string"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "notebook_id",
          "document_id",
          "version_id"
        ],
        "title": "DocumentSelection",
        "type": "object"
      },
      "EvidenceRepresentation": {
        "enum": [
          "canonical_text",
          "title_metadata",
          "ocr_text",
          "vision_analysis",
          "visual_vector",
          "asset_metadata",
          "multilingual_text",
          "positional_metadata"
        ],
        "title": "EvidenceRepresentation",
        "type": "string"
      },
      "SelectedNotebooks": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "selected",
            "title": "Kind",
            "type": "string"
          },
          "notebook_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Notebook Ids",
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "notebook_ids"
        ],
        "title": "SelectedNotebooks",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "contract_version": {
        "const": "mnemo.scope-review/1",
        "default": "mnemo.scope-review/1",
        "title": "Contract Version",
        "type": "string"
      },
      "cursor": {
        "anyOf": [
          {
            "maxLength": 8192,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cursor"
      },
      "documents": {
        "default": [],
        "items": {
          "$ref": "#/$defs/DocumentSelection"
        },
        "maxItems": 200,
        "title": "Documents",
        "type": "array"
      },
      "limit": {
        "default": 20,
        "maximum": 200,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "mode": {
        "default": "ranked",
        "enum": [
          "ranked",
          "traversal"
        ],
        "title": "Mode",
        "type": "string"
      },
      "query": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "\\S",
        "title": "Query",
        "type": "string"
      },
      "representations": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/EvidenceRepresentation"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Representations",
        "uniqueItems": true
      },
      "scope": {
        "discriminator": {
          "mapping": {
            "all_authorized": "#/$defs/AllAuthorizedNotebooks",
            "selected": "#/$defs/SelectedNotebooks"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SelectedNotebooks"
          },
          {
            "$ref": "#/$defs/AllAuthorizedNotebooks"
          }
        ],
        "title": "Scope"
      }
    },
    "required": [
      "query",
      "scope"
    ],
    "title": "ScopeRequestReview",
    "type": "object"
  },
  "response": {
    "$defs": {
      "AutomaticRepresentationStatus": {
        "enum": [
          "searched",
          "not_applicable",
          "unavailable",
          "incomplete",
          "failed",
          "omitted_by_budget"
        ],
        "title": "AutomaticRepresentationStatus",
        "type": "string"
      },
      "CanonicalIdentity": {
        "additionalProperties": false,
        "properties": {
          "chunk_id": {
            "minLength": 1,
            "title": "Chunk Id",
            "type": "string"
          },
          "kind": {
            "const": "canonical",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "chunk_id"
        ],
        "title": "CanonicalIdentity",
        "type": "object"
      },
      "CoverageReview": {
        "additionalProperties": false,
        "properties": {
          "completeness": {
            "$ref": "#/$defs/RetrievalCompleteness"
          },
          "examined": {
            "minimum": 0,
            "title": "Examined",
            "type": "integer"
          },
          "mode": {
            "enum": [
              "ranked",
              "traversal"
            ],
            "title": "Mode",
            "type": "string"
          },
          "next_cursor": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Cursor"
          },
          "partial": {
            "title": "Partial",
            "type": "boolean"
          },
          "returned": {
            "minimum": 0,
            "title": "Returned",
            "type": "integer"
          }
        },
        "required": [
          "completeness",
          "examined",
          "returned",
          "partial",
          "mode"
        ],
        "title": "CoverageReview",
        "type": "object"
      },
      "DerivedIdentity": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "format": "uuid",
            "title": "Asset Id",
            "type": "string"
          },
          "derivation_id": {
            "format": "uuid",
            "title": "Derivation Id",
            "type": "string"
          },
          "kind": {
            "const": "derived",
            "title": "Kind",
            "type": "string"
          },
          "occurrence_id": {
            "format": "uuid",
            "title": "Occurrence Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "occurrence_id",
          "asset_id",
          "derivation_id"
        ],
        "title": "DerivedIdentity",
        "type": "object"
      },
      "ErrorCategory": {
        "enum": [
          "invalid_input",
          "unauthorized",
          "not_found",
          "capability_unavailable",
          "configuration_mismatch",
          "schema_compatibility",
          "retrieval_failure",
          "transport_failure",
          "timeout",
          "server_failure"
        ],
        "title": "ErrorCategory",
        "type": "string"
      },
      "EvidenceAncestryReview": {
        "additionalProperties": false,
        "description": "One notebook-qualified evidence membership, never a global bearer ID.",
        "properties": {
          "citation": {
            "minLength": 1,
            "title": "Citation",
            "type": "string"
          },
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "generation_alias": {
            "minLength": 1,
            "title": "Generation Alias",
            "type": "string"
          },
          "generation_id": {
            "format": "uuid",
            "title": "Generation Id",
            "type": "string"
          },
          "identity": {
            "discriminator": {
              "mapping": {
                "canonical": "#/$defs/CanonicalIdentity",
                "derived": "#/$defs/DerivedIdentity",
                "structured": "#/$defs/StructuredIdentity"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CanonicalIdentity"
              },
              {
                "$ref": "#/$defs/DerivedIdentity"
              },
              {
                "$ref": "#/$defs/StructuredIdentity"
              }
            ],
            "title": "Identity"
          },
          "locator": {
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "notebook_id": {
            "format": "uuid",
            "title": "Notebook Id",
            "type": "string"
          },
          "retrieval_path": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Retrieval Path",
            "type": "array"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "notebook_id",
          "source_id",
          "document_id",
          "version_id",
          "generation_id",
          "generation_alias",
          "identity",
          "locator",
          "retrieval_path",
          "citation"
        ],
        "title": "EvidenceAncestryReview",
        "type": "object"
      },
      "EvidenceRepresentation": {
        "enum": [
          "canonical_text",
          "title_metadata",
          "ocr_text",
          "vision_analysis",
          "visual_vector",
          "asset_metadata",
          "multilingual_text",
          "positional_metadata"
        ],
        "title": "EvidenceRepresentation",
        "type": "string"
      },
      "OmissionReview": {
        "additionalProperties": false,
        "description": "Server-produced, bounded reason code for an applicable unsearched source.",
        "properties": {
          "notebook_id": {
            "format": "uuid",
            "title": "Notebook Id",
            "type": "string"
          },
          "reason_code": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Reason Code",
            "type": "string"
          },
          "representation": {
            "$ref": "#/$defs/EvidenceRepresentation"
          },
          "status": {
            "enum": [
              "unavailable",
              "incomplete",
              "failed",
              "omitted_by_budget"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "notebook_id",
          "representation",
          "status",
          "reason_code"
        ],
        "title": "OmissionReview",
        "type": "object"
      },
      "RetrievalCompleteness": {
        "enum": [
          "complete",
          "partial",
          "truncated",
          "unknown",
          "empty"
        ],
        "title": "RetrievalCompleteness",
        "type": "string"
      },
      "SafeErrorReview": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "$ref": "#/$defs/ErrorCategory"
          },
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          }
        },
        "required": [
          "category",
          "correlation_id"
        ],
        "title": "SafeErrorReview",
        "type": "object"
      },
      "SourceStatusReview": {
        "additionalProperties": false,
        "properties": {
          "matched": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Matched"
          },
          "notebook_id": {
            "format": "uuid",
            "title": "Notebook Id",
            "type": "string"
          },
          "representation": {
            "$ref": "#/$defs/EvidenceRepresentation"
          },
          "status": {
            "$ref": "#/$defs/AutomaticRepresentationStatus"
          }
        },
        "required": [
          "notebook_id",
          "representation",
          "status"
        ],
        "title": "SourceStatusReview",
        "type": "object"
      },
      "StructuredIdentity": {
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "format": "uuid",
            "title": "Dataset Id",
            "type": "string"
          },
          "kind": {
            "const": "structured",
            "title": "Kind",
            "type": "string"
          },
          "row_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Row Ids",
            "type": "array"
          }
        },
        "required": [
          "kind",
          "dataset_id",
          "row_ids"
        ],
        "title": "StructuredIdentity",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "contract_version": {
        "const": "mnemo.scope-review/1",
        "default": "mnemo.scope-review/1",
        "title": "Contract Version",
        "type": "string"
      },
      "coverage": {
        "$ref": "#/$defs/CoverageReview"
      },
      "errors": {
        "default": [],
        "items": {
          "$ref": "#/$defs/SafeErrorReview"
        },
        "title": "Errors",
        "type": "array"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/EvidenceAncestryReview"
        },
        "title": "Evidence",
        "type": "array"
      },
      "omissions": {
        "default": [],
        "items": {
          "$ref": "#/$defs/OmissionReview"
        },
        "title": "Omissions",
        "type": "array"
      },
      "sources": {
        "items": {
          "$ref": "#/$defs/SourceStatusReview"
        },
        "title": "Sources",
        "type": "array"
      }
    },
    "required": [
      "evidence",
      "sources",
      "coverage"
    ],
    "title": "ScopeResponseReview",
    "type": "object"
  }
}
