{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemo.local/schemas/phase8.5-multilingual-evaluation-contract-v1.json",
  "title": "Proposed Mnemo Phase 8.5 Multilingual Evaluation Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_id",
    "status",
    "approval",
    "corpus",
    "query_construction",
    "directional_cohorts",
    "secondary_cohorts",
    "qrels_contract",
    "metric_contract",
    "uncertainty_contract",
    "threshold_contract_ref",
    "latency_contract",
    "zero_tolerance_gates",
    "wp16_mapping",
    "environment_identity",
    "digests"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "mnemo.multilingual-evaluation-contract/1"},
    "contract_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["template", "proposed", "approved", "retired"]},
    "approval": {"$ref": "#/$defs/approval"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "query_construction": {"type": "object"},
    "directional_cohorts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/cohort"}
    },
    "secondary_cohorts": {"type": "array", "minItems": 11, "items": {"$ref": "#/$defs/cohort"}},
    "qrels_contract": {"type": "object"},
    "metric_contract": {"type": "object"},
    "uncertainty_contract": {"type": "object"},
    "threshold_contract_ref": {"type": "string", "minLength": 1},
    "latency_contract": {"type": "object"},
    "zero_tolerance_gates": {"type": "object", "minProperties": 17, "additionalProperties": {"const": 0}},
    "wp16_mapping": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}},
    "environment_identity": {"type": "object"},
    "digests": {"$ref": "#/$defs/digests"}
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approver_id", "approved_at"],
      "properties": {
        "state": {"enum": ["pending", "approved", "rejected"]},
        "approver_id": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "source_document_count", "source_digest_sha256", "candidate_universe", "mutation_permitted"],
      "properties": {
        "corpus_id": {"type": "string", "minLength": 1},
        "source_document_count": {"const": 44},
        "source_digest_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_universe": {"type": "string", "minLength": 1},
        "mutation_permitted": {"const": false}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "purpose", "target_count", "answerable", "included_in_ranking_metrics", "overlap_allowed", "required_evidence_types", "language_direction", "judgment_requirements", "approval_state"],
      "properties": {
        "cohort_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "target_count": {"type": "integer", "minimum": 1},
        "answerable": {"type": "boolean"},
        "included_in_ranking_metrics": {"type": "boolean"},
        "overlap_allowed": {"type": "boolean"},
        "required_evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["canonical_chunk", "ocr_region", "vision_derivation", "transliteration_derivation", "translation_derivation", "any_authorized"]}},
        "language_direction": {"enum": ["en->en", "en->hi", "en->mr", "hi->en", "hi->hi", "hi->mr", "mr->en", "mr->hi", "mr->mr", "hi-latin->hi", "mr-latin->mr", "mixed", "not_applicable", "varies"]},
        "judgment_requirements": {"type": "string", "minLength": 1},
        "approval_state": {"enum": ["proposed_requires_human_approval", "approved"]}
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "query_sha256", "qrels_sha256"],
      "properties": {
        "manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "query_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "qrels_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
