{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemo.local/schemas/phase8_5_capability_matrix.schema.json",
  "title": "Mnemo Phase 8.5 capability contract matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_date",
    "authority",
    "state_semantics",
    "runtime_mapping",
    "frozen_v1",
    "capabilities",
    "work_packages",
    "phase_11_non_goals"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "snapshot_date": {"type": "string", "format": "date"},
    "authority": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "state_semantics": {"type": "object"},
    "runtime_mapping": {"type": "object"},
    "frozen_v1": {"type": "object"},
    "capabilities": {
      "type": "array",
      "minItems": 28,
      "items": {"$ref": "#/$defs/capability"}
    },
    "work_packages": {
      "type": "array",
      "minItems": 18,
      "items": {"$ref": "#/$defs/work_package"}
    },
    "phase_11_non_goals": {
      "type": "array",
      "minItems": 7,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "state": {"type": ["boolean", "null"]},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "owner", "dependencies", "storage_or_index", "http", "mcp",
        "readiness_conditions", "completeness", "security",
        "certification_requirements", "states", "evidence", "gap"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "owner": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "storage_or_index": {"type": "array", "items": {"type": "string"}},
        "http": {"type": "array", "items": {"type": "string"}},
        "mcp": {"type": "array", "items": {"type": "string"}},
        "readiness_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "completeness": {"type": "string", "minLength": 1},
        "security": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "certification_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code_present", "configured", "provider_ready", "generation_present",
            "generation_active", "exposed_http", "exposed_mcp", "discoverable",
            "behaviorally_verified", "security_verified", "certified"
          ],
          "properties": {
            "code_present": {"$ref": "#/$defs/state"},
            "configured": {"$ref": "#/$defs/state"},
            "provider_ready": {"$ref": "#/$defs/state"},
            "generation_present": {"$ref": "#/$defs/state"},
            "generation_active": {"$ref": "#/$defs/state"},
            "exposed_http": {"$ref": "#/$defs/state"},
            "exposed_mcp": {"$ref": "#/$defs/state"},
            "discoverable": {"$ref": "#/$defs/state"},
            "behaviorally_verified": {"$ref": "#/$defs/state"},
            "security_verified": {"$ref": "#/$defs/state"},
            "certified": {"$ref": "#/$defs/state"}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "gap": {"type": "string"}
      }
    },
    "work_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "depends_on", "priority", "phase_11_boundary"],
      "properties": {
        "id": {"type": "string", "pattern": "^WP-[0-9]{2}$"},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "phase_11_boundary": {"type": "boolean"}
      }
    }
  }
}
