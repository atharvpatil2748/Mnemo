    "declared": "A matrix capability row exists; code_present separately records implementation availability.",
    "configured": "Maps directly to states.configured.",
    "buildable": "Computed at runtime from code presence, exact profile registration, and service construction; it is not inferred from a persisted matrix boolean.",
    "ready": "Computed at runtime from successful provider/service probes and, where applicable, a READY generation.",
    "active": "Computed at runtime from ready state plus explicit activation and active-generation selection; generation-backed activation maps additionally to states.generation_active.",
    "exposed": "Maps to the applicable states.exposed_http and states.exposed_mcp transport snapshots.",
    "verified": "Maps to states.behaviorally_verified and states.security_verified as independent evidence dimensions.",
    "certified": "Maps directly to states.certified and is never inferred by the runtime."
