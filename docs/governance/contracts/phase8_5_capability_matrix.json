    "exposed_http": "A compatible production HTTP adapter exposes the capability.",
    "exposed_mcp": "A compatible production MCP tool/resource exposes the capability.",
    "discoverable": "An unfamiliar client can infer availability, intended use, bounds, and chaining from public metadata.",
    "behaviorally_verified": "End-to-end behavior, not only class/direct-call conformance, passed for this exact snapshot.",
